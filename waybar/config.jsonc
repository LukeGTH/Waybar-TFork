
{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": ["custom/clock"],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["pulseaudio" , "custom/control" , "custom/thunar" , "custom/code" , "custom/firefox","network","custom/battery","custom/power"],

    "custom/battery": {
      "format": "{}% ",
      "tooltip": true,
      "interval": 30,
       "exec": "termux-battery-status | jq '.percentage'"
    },

    "sway/workspaces": {
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5 ]
        }
    },

    "custom/foot":{
        "format":"",
        "on-click":"foot"
    },

    "custom/control":{
        "format":"  ",
        "on-click":"better-control"
    },
    "custom/thunar":{
        "format":"  ",
        "on-click":"dolphin"
    },
    "custom/code":{
        "format":"   ",
        "on-click":"code"
    },
    "custom/firefox":{
        "format":"   ┃",
        "on-click":"firefox"
    },


    "pulseaudio":{
        "format":"  {volume}%",
        "tooltip":false
    },

    "custom/power": {
        "format": " ",
        "on-click":"shutdown -h now"
    },

    "custom/clock": {
        "format": " {}",
        "exec": "date +'%I:%M:%S %p'",
        "interval": 1,
        "tooltip": false
    },

    "network": {
        "format-wifi": " ",
        "on-click": "control --minimal --wifi",
        "tooltip":false
    },

    "custom/expand": {
        "format": "",
        "tooltip": false
    }
}
